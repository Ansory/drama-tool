{
  "name": "drama-tool",
  "version": "1.0.3",
  "description": "Video Generator + Planner Konten Drama China",
  "main": "src/main/main.js",
  "author": {
    "name": "Ansory",
    "email": "support@dramatool.com",
    "url": "https://github.com/Ansory"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ansory/drama-tool.git"
  },
  "homepage": "https://github.com/Ansory/drama-tool#readme",
  "bugs": {
    "url": "https://github.com/Ansory/drama-tool/issues"
  },
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development concurrently \"vite --config vite.config.mjs\" \"electron .\"",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win:portable": "npm run build && electron-builder --win portable",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "clean": "rimraf dist",
    "lint": "eslint src/**/*.{js,jsx}",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-log": "^5.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.dramatool.app",
    "productName": "DramaTool",
    "copyright": "Copyright © 2026 Ansory",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "dist/renderer/**/*",
      "src/main/**/*",
      "assets/**/*",
      "!**/*.map",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "DramaTool-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DramaTool",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "license": "assets/LICENSE.txt",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "perMachine": false,
      "multiLanguageInstaller": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Video"
    },
    "publish": {
      "provider": "github",
      "owner": "Ansory",
      "repo": "drama-tool",
      "private": false,
      "releaseType": "release",
      "updaterCacheDirName": "drama-tool-updater"
    },
    "extraResources": [
      {
        "from": "backend/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "forceCodeSigning": false
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

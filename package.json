{
  "name": "drama-tool",
  "version": "1.0.0",
  "description": "Video Generator + Planner Konten Drama China",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite --config vite.config.mjs\" \"electron .\"",
    "build": "vite build --config vite.config.mjs",
    "build:win": "npm run build && electron-builder --win --x64",
    "start": "electron .",
    "preview": "vite preview --config vite.config.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "concurrently": "^9.0.0"
  },
  "build": {
    "appId": "com.dramatool.app",
    "productName": "Drama Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "preload.js",
      "autoUpdater.js"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/installer.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DramaTool",
      "license": "assets/LICENSE.txt"
    },
    "publish": {
      "provider": "github",
      "owner": "Ansory",
      "repo": "drama-tool"
    }
  },
  "author": "DramaTool Team"
}
